# SQLite database path. In Docker this is mounted at /data/budget.db.
DATABASE_URL=file:./data/budget.db

# 32+ byte secret for Auth.js session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret

# Full URL used by Auth.js callbacks. For LAN use https://budget.local
AUTH_URL=https://budget.local

# Blank = Caddy serves https://budget.local via internal CA (trust it on LAN devices).
# Set to a real domain (e.g. budget.example.com) to enable Let's Encrypt.
DOMAIN=

# IANA timezone used for day calculations in the projection engine.
TZ=America/New_York

# Node runtime environment
NODE_ENV=production

# Plaid API credentials (https://dashboard.plaid.com/signup)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# Generate with: openssl rand -hex 32   — NEVER commit the real value
PLAID_ENCRYPTION_KEY=

# Public URL of this app, used to build the Plaid OAuth redirect_uri AND the
# Plaid webhook receiver URL (<APP_URL>/api/plaid/webhook).
# REQUIRED in production for OAuth-only banks (Chase, BofA, Navy Federal, etc.)
# to load. Must be registered verbatim in the Plaid dashboard
# (Team Settings → API → Allowed redirect URIs) — Plaid will reject unknown URIs.
# Leave blank in dev/sandbox if you only use non-OAuth test institutions.
APP_URL=

# Web push (interest alerts to installed PWAs). All three must be set or push
# stays disabled. Generate the keypair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact URI required by push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
