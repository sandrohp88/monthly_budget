# Points the dev server at the disposable fixture database instead of your
# real dev data. Usage:
#
#   npm run seed:fixture         # (re)generate data/dev-fixture.db
#   cp .env.fixture .env.local   # point `npm run dev` at it
#   npm run dev
#   rm .env.local                # back to your real dev data
#
# Login: dev@fixture.local / dev-fixture-pw1
DATABASE_URL=file:./data/dev-fixture.db
